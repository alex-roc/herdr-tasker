{
  "id": "root",
  "type": "row",
  "preview": "layouts/tasker.svg",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 330
      },
      "min": 44,
      "max": 520,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "tasker-lists",
          "type": "stack",
          "active": "tasker-sidebar",
          "min": 120,
          "children": [
            {
              "id": "tasker-sidebar",
              "type": "block",
              "content": {
                "mod": "tasker",
                "props": {
                  "role": "sidebar"
                }
              }
            },
            {
              "id": "tasker-split",
              "type": "column",
              "children": [
                {
                  "id": "tasker-projects",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "tasker",
                    "props": {
                      "role": "sidebar",
                      "view": "projects"
                    }
                  }
                },
                {
                  "id": "tasker-now",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "tasker",
                    "props": {
                      "role": "sidebar",
                      "view": "now"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "tasker-detail",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 360
              },
              "min": 280,
              "max": 640,
              "children": [
                {
                  "id": "tasker-detail-body",
                  "type": "block",
                  "content": {
                    "mod": "tasker",
                    "props": {
                      "role": "detail"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "tasker",
            "props": {
              "role": "status"
            }
          }
        }
      ]
    }
  ],
  "theme": {
    "light": "paper",
    "dark": "tasker"
  }
}
